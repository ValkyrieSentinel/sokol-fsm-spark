project Sokol_FSM is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Compiler is
      for Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatwe");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all", "--timeout=10");
   end Prove;
end Sokol_FSM;