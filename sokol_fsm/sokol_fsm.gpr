with "config/sokol_fsm_config.gpr";
project Sokol_Fsm is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sokol_Fsm_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sokol_fsm.adb");

   package Compiler is
      for Default_Switches ("Ada") use Sokol_Fsm_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sokol_Fsm;
